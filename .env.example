# true (default) = only hosts in config/allowlist.yaml; false = any http(s) host (URL checks and same-origin guard still apply)
LOCALHOST_ONLY=true

# Mail provider for email verification: mailpit (default, local) or cloudflare (your own domain via cloudflare/mail-worker)
MAIL_PROVIDER=mailpit
# Domain for generated test addresses (agent-xxxx@MAIL_DOMAIN); default authagent.test
MAIL_DOMAIN=authagent.test
# cloudflare only: the deployed worker URL and its API_TOKEN secret (the worker host must be in user_hosts)
MAIL_API_URL=
MAIL_API_TOKEN=
